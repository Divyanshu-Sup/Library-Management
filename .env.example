# Copy this file to .env and replace the session secret with a random value.
MONGO_URI=mongodb://127.0.0.1:27017/pustakshala
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=3000
NODE_ENV=development

# Used only by npm run create-admin
ADMIN_USERNAME=libraryadmin
ADMIN_PASSWORD=replace-with-a-strong-password
