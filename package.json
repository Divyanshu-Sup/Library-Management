{
  "name": "pustakshala-library-management",
  "version": "1.1.0",
  "description": "A student and administrator library management system built with Express and MongoDB.",
  "main": "app.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env app.js",
    "dev": "node --watch --env-file-if-exists=.env app.js",
